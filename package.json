{
  "name": "dsh-degeneration-guard",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：检测思考段复读并自动打断、自动续跑。通用重复检测，不依赖白名单；支持行内重复开关、可编辑拦截提示词与聊天内提示。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "config.js",
    "detect.js",
    "stream-guard.js",
    "resume.js",
    "turn-stopping-guard.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "repetition",
    "degeneration",
    "loop",
    "reasoning",
    "复读",
    "退化"
  ],
  "author": "BlueMika111 <huang20080115@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueMika111/dsh-degeneration-guard.git"
  },
  "homepage": "https://github.com/BlueMika111/dsh-degeneration-guard#readme",
  "bugs": {
    "url": "https://github.com/BlueMika111/dsh-degeneration-guard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test-detect.mjs && node test-stream.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "meta": {
      "title": "复读打断",
      "description": "检测思考段复读并自动打断，无需手动继续"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-0 || >=0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-0 || >=0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-0 || >=0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-0 || >=0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-0 || >=0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  }
}
